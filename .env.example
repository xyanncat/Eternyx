# Copy to .env and fill in — NEVER commit .env
# Application ID from the Discord Developer Portal (General Information)
CLIENT_ID=
# Bot token from the Developer Portal (Bot → Reset Token). Rotate if the phone is lost.
DISCORD_TOKEN=
# The dev server ID (enable Developer Mode in Discord → right-click server → Copy ID)
GUILD_ID=
# Comma-separated Discord user IDs that are bot owners (owner-only commands)
# Optional: the Discord server owner is an implicit bot owner, so this may stay empty.
OWNER_IDS=123456789012345678
# Optional: remote dashboard (Vercel). Reporting stays disabled unless BOTH are set.
# DASHBOARD_URL=https://eternyx-dashboard.vercel.app
# DASHBOARD_INGEST_KEY= (phone push key — also in dashboard/.env.local; never commit)
